# 売上を受け取るアドレス（自分で管理しているウォレット）
PAY_TO=0xYourAddress

# 課金するネットワーク
#   練習用: eip155:84532（Base Sepolia）
#   本番  : eip155:8453（Base）
X402_NETWORK=eip155:84532

# Coinbase（CDP）のファシリテーターを使うときのAPIキー。2つとも入れると自動でCDPに切り替わる。
# 本番では必須。値はVercelの環境変数にだけ入れ、チャットやGitHubには載せない。
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# CDPのキーが空のときだけ使う、練習用ファシリテーター（登録不要）
FACILITATOR_URL=https://x402.org/facilitator

# 1回あたりの価格
PRICE=$0.02

# 調査対象（Base本番）を読むためのRPC。空なら公開RPCを使用
BASE_RPC_URL=

# 売上の記録（Notion）。NOTION_TOKEN を入れると、決済が成立するたびに「売上記録」へ1行書く。
# 値は Vercel の環境変数にだけ入れ、チャットや GitHub に載せない。
NOTION_TOKEN=
# 売上記録の data source ID（空なら既定の「AIエージェントの店（x402）/売上記録」）
NOTION_SALES_DATA_SOURCE_ID=
# 運営者自身の購入アドレス（区分を「運営者」にする。空なら既定値）
OWNER_ADDRESS=
